# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key (Supabase → Project Settings → API → service_role) — ใช้ฝั่ง server เท่านั้น
# ใช้ดึงไฟล์ชีทจาก bucket private ให้หน้า /read — ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้ามแชร์ให้ใคร
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# วันสอบสำหรับนับถอยหลัง (YYYY-MM-DD)
NEXT_PUBLIC_NEXT_EXAM_DATE=2026-10-05
NEXT_PUBLIC_NEXT_EXAM_LABEL=สอบปลายภาค เทอม 1/2569
